    {
      "step": 4,
      "title": "What you're looking for",
      "intro": "Your must-haves. We use only facts each woman has chosen to share in her own answers. We never ask about, or match on, appearance."
    },
    {
      "step": 5,
      "title": "Your photos",
      "intro": "1 to 3 photos. Recent, your face clearly visible, only you in the picture."
    },
    {
      "step": 6,
      "title": "Your message, then send",
      "intro": "Write your message, check your answers, then send your profile to James."
    }
  ],
